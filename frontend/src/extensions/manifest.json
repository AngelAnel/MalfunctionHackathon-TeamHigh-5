{
  "manifest_version": 3,
  "name": "Minute-Reminder",
  "version": "1.0.0",
  "description": "A ragebait focus timer that blocks every tab with a reminder you can't escape.",
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "kill-switch": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Emergency unlock (clears the session lock)"
    }
  }
}